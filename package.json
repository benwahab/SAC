{
  "name": "sac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.functions.json",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist",
    "test:crypto": "node --experimental-strip-types --test tests/location-crypto.test.ts",
    "test:devices": "node --experimental-strip-types --test tests/device-lifecycle.test.ts",
    "test:certificates": "node --experimental-strip-types --test tests/device-certificate.test.ts",
    "test:sessions": "node --experimental-strip-types --test tests/session-authorization.test.ts",
    "test:alerts": "node --experimental-strip-types --test tests/alert-lifecycle.test.ts",
    "test:responses": "node --experimental-strip-types --test tests/alert-responses.test.ts",
    "test:trips": "node --experimental-strip-types --test tests/trip-protection.test.ts",
    "test:accounts": "node --experimental-strip-types --test tests/account-lifecycle.test.ts",
    "test:auth-policy": "node --experimental-strip-types --test tests/auth-policy.test.ts",
    "test:email": "node --experimental-strip-types --test tests/resend-email.test.ts",
    "test:otp-policy": "node --experimental-strip-types --test tests/email-otp-policy.test.ts",
    "test:registration-policy": "node --experimental-strip-types --test tests/registration-policy.test.ts",
    "test:otp-code": "node --experimental-strip-types --test tests/email-otp-code.test.ts",
    "test:password-hash": "node --experimental-strip-types --test tests/password-hash.test.ts",
    "test:jcs": "node --experimental-strip-types --test tests/jcs-canonicalization.test.ts",
    "test:jcs-input": "node --experimental-strip-types --test tests/strict-json.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "canonicalize": "5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.20.0"
  }
}
